+PRUEBA_JS_PAGINA = """
+const elementos = {};
+const escrituras = [];
+function elemento(id) {
+  if (!elementos[id]) {
+    const el = { listeners: {}, addEventListener(ev, fn) { this.listeners[ev] = fn; } };
+    let html = "";
+    Object.defineProperty(el, "innerHTML", {
+      get() { return html; },
+      set(v) { html = v; escrituras.push({ id, html: v }); },
+    });
+    elementos[id] = el;
+  }
+  return elementos[id];
+}
+globalThis.document = { getElementById: elemento };
+const fetchReal = globalThis.fetch;
+globalThis.fetch = (url, opts) => fetchReal(BASE + url, opts);
+
+const esperar = (cond) => new Promise((resolver, rechazar) => {
+  const inicio = Date.now();
+  const iv = setInterval(() => {
+    if (cond()) { clearInterval(iv); resolver(); }
+    else if (Date.now() - inicio > 5000) { clearInterval(iv); rechazar(new Error("tiempo agotado")); }
+  }, 10);
+});
+const filas = (html) => [...html.matchAll(/<tr data-sku="([^"]+)"( class="stock-bajo")?>/g)]
+  .map(m => ({ sku: m[1], bajo: Boolean(m[2]) }));
+const tablas = () => escrituras.filter(e => e.id === "productos").map(e => e.html);
+
+(0, eval)(SCRIPT);
+(async () => {
+  await esperar(() => tablas().length >= 1);
+  const sinFiltro = filas(tablas()[0]);
+  elemento("buscador").value = FILTRO;
+  elemento("buscador").listeners.input({ target: { value: FILTRO } });
+  await esperar(() => tablas().length >= 2);
+  const conFiltro = filas(tablas()[1]);
+  console.log(JSON.stringify({ sinFiltro, conFiltro }));
+})().catch(e => { console.error(e.message); process.exit(1); });
+"""
+
+
+@pytest.mark.skipif(shutil.which("node") is None, reason="hace falta node para ejecutar el JS de la página")
+def test_pagina_resalta_solo_las_filas_con_stock_bajo(base_url):
+    html = get_texto(f"{base_url}/")
+    coincidencia = re.search(r"<script>(.*?)</script>", html, re.DOTALL)
+    assert coincidencia is not None
+    script = coincidencia.group(1)
+    programa = (
+        f"const SCRIPT = {json.dumps(script)};\n"
+        f"const BASE = {json.dumps(base_url)};\n"
+        f"const FILTRO = {json.dumps('teclado')};\n"
+        + PRUEBA_JS_PAGINA
+    )
+    salida = subprocess.run(
+        ["node", "-e", programa], capture_output=True, text=True, timeout=60, check=True
+    ).stdout
+    resultado = json.loads(salida)
+
+    bajos = {f["sku"] for f in resultado["sinFiltro"] if f["bajo"]}
+    assert len(resultado["sinFiltro"]) == len(datos.CATALOGO)
+    assert bajos == {"RAT-02", "AUR-05"}
+    assert {f["sku"]: f["bajo"] for f in resultado["conFiltro"]} == {"TEC-01": False}
